{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manna-storage-mirror",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "MEDIA_MIRROR", "bucket_name": "manna-private-media-mirror" }],
  "vars": { "MIRROR_ENABLED": "true", "ACCOUNT_DELETION_ENABLED": "true" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
